function openPopup(popupId) {
    if (typeof elementorProFrontend === 'undefined') return;
    if (!elementorProFrontend.modules || !elementorProFrontend.modules.popup) return;
    elementorProFrontend.modules.popup.showPopup({id: popupId});
}
	

function loadCustomerData(id){
    showLoading();

    fetch('/wp-json/myplugin/v1/customer/' + encodeURIComponent(id), {
        headers: { 'Accept': 'application/json' }
    })
    .then(function(response) {
        if (response.status === 404) {
            hideLoading();
            alert("No profile found");
            return null;
        }
        if (!response.ok) {
            hideLoading();
            throw new Error('Network response was not ok');
        }
        return response.json();
    })
    .then(function(data){
        if (!data) {return;}
        originalData = JSON.parse(JSON.stringify(data));
        populatePage(originalData);
        hideLoading();
    })
    .catch(function(err){
        hideLoading();
        alert('Error loading profile:', err);
    });
}

	
function isValueDifferent(data, formName){
	if (formName === 'client'){
			if (first_name && first_name.value !== data.first_name){
			return true;
		}

		if (last_name && last_name.value !== data.last_name){
			return true;
		}

		if (phone_number && phone_number.value !== data.phone_number){
			return true;
		}

		if (postal_code && postal_code.value !== data.postal_code){
			return true;
		}

		if (email && email.value !== data.email){
			return true;
		}
		
		if (language && language.value !== data.language){
			return true;
		}
		
		if (address && address.value !== data.address){
			return true;
		}
		
	}else if(formName === 'order'){
		var forecast = getCheckedRow();
		
		if (teamSelected && teamSelected.value !== forecast.team_assigned|| !forecast.team_assigned){
			return true;
		}
		
		if (orderStatus && orderStatus.value !== forecast.order_status){
			return true;
		}
	}
	return false;
}	
	
 function makeDateFormat(input) {
	 try {
		 var parts = input.split('/');
		 var day = parts[0];
		 var month = parts[1];
		 var year = new Date().getFullYear();
		 // get current year

		 // Manually pad day and month if needed
		 if (day.length < 2) {
			 day = '0' + day;
		 }
		 if (month.length < 2) {
			 month = '0' + month;
		 }

		 var dateString = year + '-' + month + '-' + day;

		 return dateString;
	 } catch (err) {
		 return {
			 error: 'Date format must be DD/MM'
		 };
	 }
 }	
	
function getCheckedRow(){
	var forecastTable = document.getElementById('customerTable');
	if (forecastTable){
			var checkbox = forecastTable.querySelector('tbody tr input[type="checkbox"]:checked');
    if (!checkbox) {return null;}
    var row = checkbox.closest('tr');
		var forecastId = row.dataset.id; 
   	var forecast = originalData.forecasts.find(function(f) {
    		return f.id === forecastId;
		});
		return forecast;
	}
}	

function isImageListDiff() {
  if (deletedDocs.length >0 || deletedImages.length>0){
		return true;
	}
	if (imageList.children.length > 0 || fileList.children.length> 0){
		return true;
	}
	
	return false;
}
	
function getActiveTabAndReload(){
	var activeTab = document.querySelector('.e-n-tab-title[aria-selected="true"]');
	if (activeTab) {
		var index = activeTab.getAttribute('data-tab-index');
		if (index !== null) {
			localStorage.setItem('activeEnTabIndex', index);
		}
	}

	location.reload();
	 setTimeout(() => {
        successContainer.classList.remove('hidden');
    }, 300);
}	
	
/*Save function for the Info tab*/	
function saveCustomerInfo(){
	var ajaxDataDiv = document.getElementById('ajax-data-block-client-profile');
	var ajaxNonce = ajaxDataDiv.getAttribute('data-nonce');
	var isChange = isValueDifferent(originalData, 'client');

	if (isChange) {
		showLoading();
		var newData = {
			'first_name':first_name.value,
			'last_name':last_name.value,
			'postal_code':postal_code.value,
			'email':email.value,
			'phone_number':phone_number.value,
			'language':language.value,
			'address':address.value,
			'id' : originalData.id
		};

		// Send the AJAX request
		fetch('/wp-admin/admin-ajax.php', {
			method: 'POST',
			headers: {
				'Content-Type': 'application/x-www-form-urlencoded'
			},
			body: new URLSearchParams({
				action: 'save_client_profile',
				_wpnonce: ajaxNonce,
				data: JSON.stringify(newData)
			})
		}).then(function(response) {
			return response.json();
			// Parse response as JSON
		}).then(function(data) {
			hideLoading();
			if (data && data.success) {
				getActiveTabAndReload();
				if (successContainer){
						successContainer.classList.remove('hidden');
					}
			} else {
				alert('Error while saving your table: ' + data.data);
			}
		}).catch(function(error) {
			hideLoading();
			alert('Error:', error);
		});
	} else{
		hideLoading();
		alert('No changes detected.');
	}
}
	
/*Save function for the Orders tab*/
function saveCustomerOrders(){
	var forecastTable = document.getElementById('customerTable');
	var activeForecast = getCheckedRow();
	var ajaxDataDiv = document.getElementById('ajax-data-block-client-order');
	var ajaxNonce = ajaxDataDiv.getAttribute('data-nonce');

	var isChange = isValueDifferent(originalData, 'order');  //Checks Team and Status
	var dirtyRows = forecastTable.querySelectorAll('tbody tr.dirty');  //Checks for changes in the table
	var isDirtyRows = dirtyRows.length > 0;

	var isImageListChange = isImageListDiff();  //Check if images were changed
		
	if (isChange || isDirtyRows || isImageListChange) 
	{
		var formData = new FormData();
		formData.append('_wpnonce', ajaxNonce);
		formData.append('action', 'save_client_order');
		
		showLoading();
		var forecasts = [];
		var forecast = originalData.forecasts.find(function(f) { return f.id === activeForecast.id; });
		
		if (isDirtyRows){	
			for (var i = 0; i < dirtyRows.length; i++) {
				var row = dirtyRows[i];
				//var forecastId = row.dataset.id;
				//var forecast = originalData.forecasts.find(function(f) { return f.id === forecastId; });
				if (!forecast) {continue;}
				
				var cells = row.querySelectorAll('td');
				forecast.submitted_date = makeDateFormat(cells[1].innerText.trim() || null);
				forecast.due_date       = makeDateFormat(cells[2].innerText.trim() || null);
				forecast.model          = cells[3].innerText.trim();
				forecast.model_type     = cells[4].innerText.trim();
				forecast.width          = cells[5].innerText.trim();
				forecast.depth          = cells[6].innerText.trim();
				forecast.subframe_size  = cells[7].innerText.trim();
				forecast.subframe_qty   = cells[8].innerText.trim();
				forecast.louver_size    = cells[9].innerText.trim();
				forecast.louver_qty     = cells[10].innerText.trim();
				forecast.post_size      = cells[11].innerText.trim();
				forecast.post_qty       = cells[12].innerText.trim();
				forecast.soldiers       = cells[13].innerText.trim();
				forecast.color          = cells[14].innerText.trim();
				forecast.info           = cells[16].innerText.trim();
				
				var extrasText = cells[15].innerText.trim();
				if (!extrasText) {
						forecast.extras = [];
				} else if (extrasText.includes(',')) {
						// Split by comma and trim each item
						forecast.extras = extrasText.split(',').map(function(item) { return item.trim(); });
				} else {
						// Single item, still as an array
						forecast.extras = [extrasText];
				}
				
				forecasts.push(forecast);
			}
		}
		
		if (isChange){
			if (forecasts.length>0){
				var index = forecasts.findIndex(function(forecast){return forecast.id === activeForecast.id;});
				if (index > -1){
					forecasts[index].order_status = orderStatus.value;
					forecasts[index].team_selected = teamSelected.value;		
				}else{
					forecasts.push({order_status : orderStatus.value, team_selected : teamSelected.value,id:activeForecast.id});
				}
			}else{
				forecasts.push({order_status : orderStatus.value, team_selected : teamSelected.value,id:activeForecast.id});
			}
		}
		
		if (isImageListChange){
			allDocs.forEach(item => {
				if (item instanceof File) {
						formData.append('customer_docs[]', item);
				} else if (item.url) {
						formData.append('customer_docs_urls[]', item.url);
				}
			});

			allImages.forEach(item => {
				if (item instanceof File) {
						formData.append('customer_images[]', item);
				} else if (item.url) {
						formData.append('customer_docs_images[]', item.url);
				}
			});

			formData.append('deleted_docs', JSON.stringify(deletedDocs));
			formData.append('deleted_images', JSON.stringify(deletedImages));
		}
	
		formData.append('data', JSON.stringify(forecasts));
		for (const [key, value] of formData.entries()) {
    	console.log(key, value);
		}
		
		// Send the AJAX request
		fetch('/wp-admin/admin-ajax.php', {
			method: 'POST',
			body:formData
		}).then(function(response) {
			return response.json();
			// Parse response as JSON
		}).then(function(data) {
			if (data && data.success) {
				//getActiveTabAndReload();
				activateTab();
				hideLoading();
			} else {
				hideLoading();
				alert('Error while saving your table: ' + data.data);
			}
		}).catch(function(error) {
			hideLoading();
			alert('Fetch error:', error);
		});
	} else{
		hideLoading();
		alert('No changes detected.');
	}
}	
</script>	
