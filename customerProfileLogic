<script>	
var originalData;
var data;
var orderNotification;
/*Customer Profile*/	
var title = document.getElementById('customer_profile_name');
var first_name = document.getElementById('customer_first_name');
var last_name = document.getElementById('customer_last_name');
var email = document.getElementById('customer_email');
var postal_code = document.getElementById('customer_postal_code');
var phone_number = document.getElementById('customer_phone_number');
var saveProfilBtn = document.getElementById('customer_info_save_btn');
/*Orders*/
var forecastTableContainer = document.getElementById('customer_forecast_table');	
var saveOrdersBtn = document.getElementById('customer_orders_save_btn');
var notifyTeamBtn = document.getElementById('notify_team_btn');
var notifyCustomerBtn = document.getElementById('status_update_btn');
var teamSelected = document.getElementById('team_selection');
var orderStatus = document.getElementById('order_status');
var trigger = document.getElementById('customer_file_trigger');
var input = document.getElementById('customer_profile_images');
var fileList = document.getElementById('customer_file_list');
/*Notes*/	
var addNoteBtn = document.getElementById('customer_profile_add_note_btn');
	
	
document.addEventListener('DOMContentLoaded', function () {
	teamSelected.addEventListener('change', function(){
		if (teamSelected.value && teamSelected.value !== ''){
			notifyTeamBtn.disabled = false;
		}
	});
	
	orderStatus.addEventListener('change', function(){
		if (orderStatus.value && orderStatus.value !== ''){
			notifyCustomerBtn.disabled = false;
		}
	});
	
	saveProfilBtn.addEventListener('click', function(e){
		e.preventDefault();
		e.stopPropagation();
		saveCustomerInfo();
	});
	
	saveOrdersBtn.addEventListener('click', function(e){
		e.preventDefault();
		e.stopPropagation();
		saveCustomerOrders();
	});
	
	notifyTeamBtn.addEventListener('click', function(e){
		e.preventDefault();
		e.stopPropagation();
		openPopup(4625);
	});
	
	notifyCustomerBtn.addEventListener('click', function(e){
		e.preventDefault();
		e.stopPropagation();
		notifyCustomer();
	});
	
	addNoteBtn.addEventListener('click', function(e){
		e.preventDefault();
		e.stopPropagation();
		openPopup(4837);
	});
	
	if (teamSelected && teamSelected.value === '') {
		notifyTeamBtn.disabled = true;
	}
	
	var id = getIdFromUrl();
	if (id){
		loadCustomerData(id);
	}else{
		alert("No Id retrieved");
	}
	
	trigger.addEventListener('click', function() {
			if (input) {
					input.click();
			}
	});

	input.addEventListener('change', function() {
    var files = Array.from(input.files);
    if (input.files.length === 0) {
        fileList.textContent = 'No file selected';
				fileList.style.setProperty('padding-top', '7px', 'important');
        return;
    }
		
		 if (fileList.textContent === 'No file selected') {
        fileList.textContent = '';
    }
		
    files.forEach(function(file, index) {
        var div = document.createElement('div');
        div.style.display = 'flex';
        div.style.alignItems = 'center';
        div.style.marginBottom = '4px';

        var nameSpan = document.createElement('span');
        nameSpan.textContent = file.name;
        nameSpan.style.flex = '1';

        var removeBtn = document.createElement('button');
        removeBtn.textContent = '❌';
        removeBtn.style.color = 'red';
        removeBtn.style.border = 'none';
        removeBtn.style.background = 'transparent';
        removeBtn.style.cursor = 'pointer';
        removeBtn.addEventListener('click', function() {
            div.remove();

            if (fileList.children.length === 0) {
                fileList.textContent = 'No file selected';
							  fileList.style.setProperty('padding-top', '7px', 'important');
            }
        });

        div.appendChild(nameSpan);
        div.appendChild(removeBtn);
        fileList.appendChild(div);
    });
	});
		
	activateTab();
	
});
	
function activateTab(){
	//Automatically select tab user was on
	  var savedIndex = localStorage.getItem('activeEnTabIndex');
   	if (savedIndex === null) {return;}

		// Delay execution to allow Elementor to finish initializing
		setTimeout(function () {
			var tabToActivate = document.querySelector('.e-n-tab-title[data-tab-index="' + savedIndex + '"]');
			if (tabToActivate) {
				tabToActivate.click(); // Triggers Elementor's tab logic
			}

			localStorage.removeItem('activeEnTabIndex');
		}, 200);
}	
	
/*Retrieve customer ID from UI*/	
function getIdFromUrl(){
  var query = window.location.search.substring(1); 
	var vars = query.split('&');
	for (var i = 0; i < vars.length; i++) {
		var pair = vars[i].split('=');
		if (pair[0] === 'id') {
			return decodeURIComponent(pair[1]);
		}
	}
	return null;
  }
	
	
function notifyCustomer(){
	showLoading();
	var f = getCheckedRow();
	if (orderStatus && orderStatus.value === f.order_status_notification){
		hideLoading();
		alert('Customer was already notified for this order status.');
	}else{
		var ajaxDataDiv = document.getElementById('ajax-data-block-client-order');
		var ajaxNonce = ajaxDataDiv.getAttribute('data-nonce');

		var newData = {
			'orderStatus':orderStatus.value,
			'forecastId':f.id,
			'email':originalData.email
		};

		// Send the AJAX request
		fetch('/wp-admin/admin-ajax.php', {
			method: 'POST',
			headers: {
				'Content-Type': 'application/x-www-form-urlencoded'
			},
			body: new URLSearchParams({
				action: 'update_status_and_email',
				_wpnonce: ajaxNonce,
				data: JSON.stringify(newData)
			})
		}).then(function(response) {
			return response.json();
			// Parse response as JSON
		}).then(function(data) {
			if (data && data.success) {
				location.reload();
				getActiveTabAndReload();
				//alert('Customer was successfully sent an email!');
			} else {
				hideLoading();
				alert('Error while saving your table: ' + data.data);
			}
		}).catch(function(error) {
			hideLoading();
			alert('Error:', error);
		});
	}
}	
	
function populatePage(data){	
	if (!first_name || !last_name || !email || !postal_code || !phone_number || !fileList ){return;}
	
	if (title){
		title.textContent = (data.first_name || '') + ' '+ (data.last_name || '');
		}

	first_name.value = data.first_name || '';
	last_name.value = data.last_name || '';
	email.value = data.email || '';
	postal_code.value = data.postal_code || '';
	phone_number.value = data.phone_number || '';
	
	//Right now we assume first forecast
	if (data.forecasts.length > 0){
		teamSelected.value = data.forecasts[0].team_assigned ? data.forecasts[0].team_assigned : '';
		if (teamSelected.value){notifyTeamBtn.disabled = false;}
		
		orderStatus.value = data.forecasts[0].order_status ? data.forecasts[0].order_status : '';
		if (orderStatus.value){notifyCustomerBtn.disabled = false;} else {notifyCustomerBtn.disabled = true;}
		orderNotification = data.forecasts[0].order_status_notification ? data.forecasts[0].order_status_notification : '';

		if (data.forecasts[0].image_url){
				loadDocs(data.forecasts[0].image_url);
		}	else{
			if (fileList) {
        fileList.textContent = 'No file selected';
				fileList.style.setProperty('padding-top', '7px', 'important');
    	}
		}
	}
	
  renderForecastTable(data);
	
	hideLoading();	
}

	

// Load existing URLs into the file list
function loadDocs(docs) {
    if (!Array.isArray(docs)) {
        docs = [];
    }

    fileList.textContent = '';
		fileList.style.setProperty('padding-top', '7px', 'important');

    if (docs.length > 0) {
        docs.forEach(function (url) {
            fileList.appendChild(createFileItem(url, function () {
                if (fileList.children.length === 0) {
                    fileList.textContent = 'No file selected';
									  fileList.style.setProperty('padding-top', '7px', 'important');
                }
            }, true)); // true = it's a URL
        });
    } else {
        fileList.textContent = 'No file selected';
				fileList.style.setProperty('padding-top', '7px', 'important');
    }
}
	
// Helper to create a list item for a file or URL
function createFileItem(fileOrUrl, onRemove, isUrl) {
   if (typeof isUrl === 'undefined') {
        isUrl = false;
    }  
	
		var div = document.createElement('div');
    div.style.display = 'flex';
    div.style.alignItems = 'center';
    div.style.marginBottom = '4px';

    var nameElement;

    if (isUrl) {
        // URL
        nameElement = document.createElement('a');
        nameElement.dataset.url = fileOrUrl;
        nameElement.textContent = fileOrUrl.split('/').pop();
        nameElement.href = '#';
        nameElement.style.color = 'blue';
        nameElement.style.textDecoration = 'underline';
        nameElement.style.flex = '1';
    } else {
        // Local file
        nameElement = document.createElement('span');
        nameElement.textContent = fileOrUrl.name;
        nameElement.dataset.filename = fileOrUrl.name;
        nameElement.dataset.fileIndex = null; // optional, for tracking
        nameElement.fileObject = fileOrUrl; // attach File object to span for FormData
        nameElement.style.flex = '1';
    }

    nameElement.addEventListener('click', function(e) {
        e.preventDefault();
        if (isUrl) {
            window.open(nameElement.dataset.url, '_blank', 'noopener,noreferrer');
        }
    });
 
    div.appendChild(nameElement);
    return div;
}
	
function renderForecastTable(data){
	if (!data){
		forecastTableContainer.innerHTML = 'No data found';
	}
	
	var html = '<div class="mrpergola-table-container">';
    html += '<table id="customerTable" class="mrpergola-table display">';
    html += '<thead><tr>';
	  html += '<th colspan="1"></th>';
    html += '<th colspan="2">Date</th>';
		html += '<th colspan="2"></th>';
    html += '<th colspan="2">Frames</th>';
		html += '<th colspan="2">Subframes</th>';
    html += '<th colspan="2">Louvers</th>';
		html += '<th colspan="2">Posts</th>';
    html += '<th colspan="5"></th></tr>';

    html += '<tr>';
		html += '<th class="mrpergola-col-xsmall"></th>';
    html += '<th class="mrpergola-col-xsmall">Submit</th>';
    html += '<th class="mrpergola-col-xsmall">Due</th>';
    html += '<th style="width:2%">Mdl</th>';
    html += '<th style="width:2%">Type</th>';
    html += '<th style="width:2%">Wdt</th>';
    html += '<th style="width:2%">Dpt</th>';
    html += '<th class="mrpergola-col-xsmall">Lgt</th>';
    html += '<th class="mrpergola-col-xsmall">Qty</th>';
    html += '<th class="mrpergola-col-xsmall">Lgt</th>';
    html += '<th class="mrpergola-col-xsmall">Qty</th>';
    html += '<th style="width:6%">Lgt</th>';
    html += '<th style="width:6%">Qty</th>';
    html += '<th class="mrpergola-col-xsmall">Slds</th>';
    html += '<th class="mrpergola-col-xsmall">Color</th>';
    html += '<th class="mrpergola-col-xsmall">Extras</th>';
    html += '<th>Info</th>';
    html += '</tr></thead><tbody>';

    var customStyle = 'color: blue;';	
    for (var i = 0; i < data.forecasts.length; i++) {
        var forecast = data.forecasts[i];
        var accessories = forecast.accessories || [];
        var formattedEntryDate = forecast.entry_date ? (new Date(forecast.entry_date)).toLocaleDateString('en-GB', { day:'2-digit', month:'2-digit' }) : '';
        var formattedDueDate = forecast.due_date ? (new Date(forecast.due_date)).toLocaleDateString('en-GB', { day:'2-digit', month:'2-digit' }) : '';

				 var customFlags = {};
					if (forecast.custom_fields) {
							var customValuesArray = JSON.parse(forecast.custom_fields).map(function(v) { 
									return v.trim(); 
							});

							// Create a flag for each value in the array
							for (var j = 0; j < customValuesArray.length; j++) {
									var key = customValuesArray[j];
									customFlags[key] = true;
							}
					}

			  html += '<tr data-id="' + forecast.id + '">';
				html += '<td><input type="checkbox" class="forecast-select" value="' + forecast.id + '"' + (i === 0 ? ' checked' : '') + '></td>';
        html += '<td contenteditable="true">' + formattedEntryDate + '</td>';
        html += '<td contenteditable="true">' + (forecast.due_date ? formattedDueDate : '') + '</td>';
        html += '<td contenteditable="true">' + (forecast.model || '') + '</td>';
        html += '<td contenteditable="true">' + (forecast.model_type || '') + '</td>';
			  html += '<td contenteditable="true" style="' + (customFlags.width ? customStyle : '') + '">' + (forecast.width || '') + '</td>';
				html += '<td contenteditable="true" style="' + (customFlags.depth ? customStyle : '') + '">' + (forecast.depth || '') + '</td>';
				html += '<td contenteditable="true" style="' + (customFlags.subSize ? customStyle : '') + '">' + (forecast.subframe_size || '') + '</td>';
				html += '<td contenteditable="true" style="' + (customFlags.subQty ? customStyle : '') + '">' + (forecast.subframe_qty || '') + '</td>';
        html += '<td contenteditable="true">' + (forecast.louver_size || '') + '</td>';
        html += '<td contenteditable="true">' + (forecast.louver_qty || '') + '</td>';
				html += '<td contenteditable="true" style="' + (customFlags.postSize ? customStyle : '') + '">' + (forecast.post_size || '') + '</td>';
				html += '<td contenteditable="true" style="' + (customFlags.postQty ? customStyle : '') + '">' + (forecast.post_qty || '') + '</td>';
        html += '<td contenteditable="true">' + (forecast.soldiers || '') + '</td>';
        html += '<td contenteditable="true">' + (forecast.color || '') + '</td>';
        html += '<td contenteditable="true">' + (accessories.join(', ')) + '</td>';
        html += '<td contenteditable="true">' + (forecast.info || '') + '</td>';
        html += '</tr>';
    }
    html += '</tbody></table></div>';
     if (forecastTableContainer) {
        forecastTableContainer.innerHTML = html;

        // Attach dirty tracking AFTER table exists
        var table = document.getElementById('customerTable');
        if (table) {
            table.addEventListener('input', function(e) {
                var target = e.target;
                if (target.isContentEditable) {
                    var row = target.closest('tr');
                    if (row) {row.classList.add('dirty');}
                }
            });
        }
    }
}		
	
function openPopup(popupId) {
    if (typeof elementorProFrontend === 'undefined') return;
    if (!elementorProFrontend.modules || !elementorProFrontend.modules.popup) return;
    elementorProFrontend.modules.popup.showPopup({id: popupId});
}
	

function loadCustomerData(id){
    showLoading();

    fetch('/wp-json/myplugin/v1/customer/' + encodeURIComponent(id), {
        headers: { 'Accept': 'application/json' }
    })
    .then(function(response) {
        if (response.status === 404) {
            hideLoading();
            console.log("No profile found");
            return null;
        }
        if (!response.ok) {
            hideLoading();
            throw new Error('Network response was not ok');
        }
        return response.json();
    })
    .then(function(data){
        if (!data) {return;}
        originalData = JSON.parse(JSON.stringify(data));
        populatePage(originalData);
        hideLoading();
    })
    .catch(function(err){
        hideLoading();
        console.error('Error loading profile:', err);
    });
}

	
function isValueDifferent(data, formName){
	if (formName === 'client'){
			if (first_name && first_name.value !== data.first_name){
			return true;
		}

		if (last_name && last_name.value !== data.last_name){
			return true;
		}

		if (phone_number && phone_number.value !== data.phone_number){
			return true;
		}

		if (postal_code && postal_code.value !== data.postal_code){
			return true;
		}

		if (email && email.value !== data.email){
			return true;
		}
	}else if(formName === 'order'){
		var forecast = getCheckedRow();
		
		if (teamSelected && teamSelected.value !== forecast.team_assigned|| !forecast.team_assigned){
			return true;
		}
		
		if (orderStatus && orderStatus.value !== forecast.order_status){
			return true;
		}
	}
	return false;
}	
	
 function makeDateFormat(input) {
	 try {
		 var parts = input.split('/');
		 var day = parts[0];
		 var month = parts[1];
		 var year = new Date().getFullYear();
		 // get current year

		 // Manually pad day and month if needed
		 if (day.length < 2) {
			 day = '0' + day;
		 }
		 if (month.length < 2) {
			 month = '0' + month;
		 }

		 var dateString = year + '-' + month + '-' + day;

		 return dateString;
	 } catch (err) {
		 return {
			 error: 'Date format must be DD/MM'
		 };
	 }
 }	
	
function getCheckedRow(){
	var forecastTable = document.getElementById('customerTable');
		var checkbox = forecastTable.querySelector('tbody tr input[type="checkbox"]:checked');
    if (!checkbox) {return null;}
    var row = checkbox.closest('tr');
		var forecastId = row.dataset.id; 
   	var forecast = originalData.forecasts.find(function(f) {
    		return f.id === forecastId;
		});
		return forecast;
}	

function isImageListDiff(addedImages,currentImageList,savedImageList) {
  //Images we added	
	if(addedImages && addedImages.length > 0){return true;} 
	
	//Images were deleted
	if (savedImageList.length !== currentImageList.length)  {return true;}
	
  return false;
}
	
function getActiveTabAndReload(){
	var activeTab = document.querySelector('.e-n-tab-title[aria-selected="true"]');
	if (activeTab) {
		var index = activeTab.getAttribute('data-tab-index');
		if (index !== null) {
			localStorage.setItem('activeEnTabIndex', index);
		}
	}

	location.reload();
}	
	
/*Save function for the Info tab*/	
function saveCustomerInfo(){
	var ajaxDataDiv = document.getElementById('ajax-data-block-client-profile');
	var ajaxNonce = ajaxDataDiv.getAttribute('data-nonce');
	var isChange = isValueDifferent(originalData, 'client');

	if (isChange) {
		showLoading();
		var newData = {
			'first_name':first_name.value,
			'last_name':last_name.value,
			'postal_code':postal_code.value,
			'email':email.value,
			'phone_number':phone_number.value,
			'id' : originalData.id
		};

		// Send the AJAX request
		fetch('/wp-admin/admin-ajax.php', {
			method: 'POST',
			headers: {
				'Content-Type': 'application/x-www-form-urlencoded'
			},
			body: new URLSearchParams({
				action: 'save_client_profile',
				_wpnonce: ajaxNonce,
				data: JSON.stringify(newData)
			})
		}).then(function(response) {
			return response.json();
			// Parse response as JSON
		}).then(function(data) {
			hideLoading();
			if (data && data.success) {
				getActiveTabAndReload();
				//alert('Customer\'s info successfully saved!');
			} else {
				alert('Error while saving your table: ' + data.data);
			}
		}).catch(function(error) {
			hideLoading();
			alert('Error:', error);
		});
	} else{
		hideLoading();
		alert('No changes detected.');
	}
}

/*Save function for the Orders tab*/
function saveCustomerOrders(){
	var forecastTable = document.getElementById('customerTable');
	var activeForecast = getCheckedRow();
	var ajaxDataDiv = document.getElementById('ajax-data-block-client-order');
	var ajaxNonce = ajaxDataDiv.getAttribute('data-nonce');

	var isChange = isValueDifferent(originalData, 'order');  //Checks Team and Status
	var dirtyRows = forecastTable.querySelectorAll('tbody tr.dirty');  //Checks for changes in the table
	var isDirtyRows = dirtyRows.length > 0;
	
	//should be empty is fielpicker was not used
	var addedImages = document.getElementById('customer_file_list'); 
	//Should have all old and new images
	var currentImageList = Array.from(fileList.children).map(function(item){
        var link = item.querySelector('a');
        return link ? link.dataset.url : item.textContent.trim();
    });
	var savedImageList = activeForecast.image_url;
	var isImageListChange = isImageListDiff(addedImages,currentImageList,savedImageList);  //Check if images were changed
		
	if (isChange || isDirtyRows || isImageListChange) 
	{
		showLoading();
		var forecasts = [];
		var forecast = originalData.forecasts.find(function(f) { return f.id === activeForecast.id; });
		
		if (isDirtyRows){	
			for (var i = 0; i < dirtyRows.length; i++) {
				var row = dirtyRows[i];
				//var forecastId = row.dataset.id;
				//var forecast = originalData.forecasts.find(function(f) { return f.id === forecastId; });
				if (!forecast) {continue;}
				
				var cells = row.querySelectorAll('td');
				forecast.submitted_date = makeDateFormat(cells[1].innerText.trim() || null);
				forecast.due_date       = makeDateFormat(cells[2].innerText.trim() || null);
				forecast.model          = cells[3].innerText.trim();
				forecast.model_type     = cells[4].innerText.trim();
				forecast.width          = cells[5].innerText.trim();
				forecast.depth          = cells[6].innerText.trim();
				forecast.subframe_size  = cells[7].innerText.trim();
				forecast.subframe_qty   = cells[8].innerText.trim();
				forecast.louver_size    = cells[9].innerText.trim();
				forecast.louver_qty     = cells[10].innerText.trim();
				forecast.post_size      = cells[11].innerText.trim();
				forecast.post_qty       = cells[12].innerText.trim();
				forecast.soldiers       = cells[13].innerText.trim();
				forecast.color          = cells[14].innerText.trim();
				forecast.info           = cells[16].innerText.trim();
				
				var extrasText = cells[15].innerText.trim();
				if (!extrasText) {
						forecast.extras = [];
				} else if (extrasText.includes(',')) {
						// Split by comma and trim each item
						forecast.extras = extrasText.split(',').map(function(item) { return item.trim(); });
				} else {
						// Single item, still as an array
						forecast.extras = [extrasText];
				}
				
				console.log(JSON.stringify(forecast));
				forecasts.push(forecast);
				console.log(JSON.stringify(forecasts));
			}
		}
		
		if (isChange){
			if (forecasts.length>0){
				var index = forecasts.findIndex(function(forecast){return forecast.id === activeForecast.id;});
				if (index > -1){
					forecasts[index].order_status = orderStatus.value;
					forecasts[index].team_selected = teamSelected.value;		
				}else{
					forecasts.push({order_status : orderStatus.value, team_selected : teamSelected.value,id:activeForecast.id});
				}
			}else{
				forecasts.push({order_status : orderStatus.value, team_selected : teamSelected.value,id:activeForecast.id});
			}
		}
		
		var formData = new FormData();
		formData.append('_wpnonce', ajaxNonce);
		formData.append('action', 'save_client_order');
		
		if (isImageListChange){
			 // Attach new images to save with forecast number
			if (input.files.length > 0) {
					for (var k = 0; k < input.files.length; k++) {
							var file = input.files[k];
							// Add data-forecast-id attribute to the file input element for each file
							var forecastId = file.getAttribute ? file.getAttribute('data-forecast-id') : activeForecast.id;
							formData.append('images[' + forecastId + '][]', file);
					}
			}
			if (forecasts.length>0){
				var idx = forecasts.findIndex(function(forecast){return forecast.id === activeForecast.id;});
				if (idx > -1){
					forecasts[idx].currentImageList = currentImageList;
				}else{
					forecasts.push({'id':activeForecast.id, 'image_url':activeForecast.image_url,'currentImageList' : currentImageList});
				}
			}else{
				forecasts.push({'id':activeForecast.id, 'image_url':activeForecast.image_url,'currentImageList' : currentImageList});
			}
		
		}
		
		formData.append('data', JSON.stringify(forecasts));
		console.log('data field:', formData.get('data'));
		formData.forEach(function(value, key){
    	console.log(key, value);
		});
		
		// Send the AJAX request
		fetch('/wp-admin/admin-ajax.php', {
			method: 'POST',
			body:formData
		}).then(function(response) {
			return response.json();
			// Parse response as JSON
		}).then(function(data) {
			hideLoading();
			if (data && data.success) {
				getActiveTabAndReload();
				alert('Customer\'s order successfully saved!');
			} else {
				console.log('error while saving');
				alert('Error while saving your table: ' + data.data);
			}
		}).catch(function(error) {
			hideLoading();
			console.log('fetch error');
			alert('Fetch error:', error);
			console.error('Fetch error:', error);
		});
	} else{
		hideLoading();
		alert('No changes detected.');
	}
}	
</script>	
