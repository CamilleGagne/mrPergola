function addFileItem(fileOrUrl, container, isUrl = false) {
    const div = document.createElement('div');
    div.style.display = 'flex';
    div.style.alignItems = 'center';
    div.style.justifyContent = 'space-between';
    div.style.padding = '6px 10px';
    div.style.marginBottom = '6px';
    div.style.border = '1px solid #ddd';
    div.style.borderRadius = '6px';
    div.style.backgroundColor = '#fafafa';
    div.style.fontSize = '14px';

    // Checkbox
    const checkbox = document.createElement('input');
    checkbox.type = 'checkbox';
    checkbox.style.marginRight = '8px';
    checkbox.checked = false; // default unchecked
    div.appendChild(checkbox);

    // Store the underlying data
    if (isUrl) {
        div.dataset.url = fileOrUrl;  // store URL string
    } else {
        div.file = fileOrUrl;          // store File object
    }

    // Name display
    const nameSpan = document.createElement('span');
    nameSpan.style.flex = '1';
    nameSpan.style.marginRight = '8px';
    nameSpan.style.fontSize = '14px';
    nameSpan.style.wordBreak = 'break-all';

    if (isUrl) {
        nameSpan.textContent = fileOrUrl.split('/').pop();
        nameSpan.style.color = '#007bff';
        nameSpan.style.cursor = 'pointer';

        nameSpan.addEventListener('click', () => {
            window.open(fileOrUrl, '_blank', 'noopener,noreferrer');
        });

        // Thumbnail for image URLs
        if (/\.(jpeg|jpg|gif|png|webp|svg)$/i.test(fileOrUrl)) {
            const img = document.createElement('img');
            img.src = fileOrUrl;
            img.style.width = '60px';
            img.style.height = '60px';
            img.style.objectFit = 'cover';
            img.style.marginRight = '8px';
            div.insertBefore(img, checkbox.nextSibling);
        }

    } else {
        const file = fileOrUrl;

        // Thumbnail for image files
        if (file.type.startsWith('image/')) {
            const reader = new FileReader();
            reader.onload = (e) => {
                const img = document.createElement('img');
                img.src = e.target.result;
                img.style.width = '60px';
                img.style.height = '60px';
                img.style.objectFit = 'cover';
                img.style.marginRight = '8px';
                div.insertBefore(img, checkbox.nextSibling);
            };
            reader.readAsDataURL(file);
        }

        nameSpan.textContent = file.name;
    }

    // Remove button
    const removeBtn = document.createElement('button');
    removeBtn.innerHTML = '✕';
    removeBtn.style.color = '#fff';
    removeBtn.style.background = '#e74c3c';
    removeBtn.style.border = 'none';
    removeBtn.style.borderRadius = '4px';
    removeBtn.style.cursor = 'pointer';
    removeBtn.style.padding = '2px 6px';
    removeBtn.style.fontSize = '12px';
    removeBtn.addEventListener('click', () => {
        div.remove();
        if (typeof fileOrUrl === 'string') {
            if (container.id === 'customer_image_list') {
                deletedImages.push(fileOrUrl);
            } else {
                deletedDocs.push(fileOrUrl);
            }
        }
        if (container.children.length === 0) {
            container.textContent = 'No file selected';
            container.style.setProperty('padding-top', '7px', 'important');
        }
    });

    div.appendChild(nameSpan);
    div.appendChild(removeBtn);
    container.appendChild(div);
}


function saveActiveTab(){
		var activeTab = document.querySelector('.e-n-tab-title[aria-selected="true"]');
			if (activeTab) {
				var index = activeTab.getAttribute('data-tab-index');
				if (index !== null) {
					localStorage.setItem('activeEnTabIndex', index);
				}
			}
}	
	
function activateTab(){
	//Automatically select tab user was on
	  var savedIndex = localStorage.getItem('activeEnTabIndex');
   	if (savedIndex === null) {return;}

		// Delay execution to allow Elementor to finish initializing
		setTimeout(function () {
			var tabToActivate = document.querySelector('.e-n-tab-title[data-tab-index="' + savedIndex + '"]');
			if (tabToActivate) {
				tabToActivate.click(); // Triggers Elementor's tab logic
			}

			localStorage.removeItem('activeEnTabIndex');
		}, 200);
}	
	
/*Retrieve customer ID from UI*/	
function getIdFromUrl(){
  var query = window.location.search.substring(1); 
	var vars = query.split('&');
	for (var i = 0; i < vars.length; i++) {
		var pair = vars[i].split('=');
		if (pair[0] === 'id') {
			return decodeURIComponent(pair[1]);
		}
	}
	return null;
  }
	
	
function notifyCustomer(){
	showLoading();
	var f = getCheckedRow();
	if (orderStatus && orderStatus.value === f.order_status_notification){
		hideLoading();
		alert('Customer was already notified for this order status.');
	}else{
		var ajaxDataDiv = document.getElementById('ajax-data-block-client-order');
		var ajaxNonce = ajaxDataDiv.getAttribute('data-nonce');

		var newData = {
			'orderStatus':orderStatus.value,
			'forecastId':f.id,
			'email':originalData.email,
			'customerName':originalData.first_name,
			'language':language ? language.value : 'en'
		};

		// Send the AJAX request
		fetch('/wp-admin/admin-ajax.php', {
			method: 'POST',
			headers: {
				'Content-Type': 'application/x-www-form-urlencoded'
			},
			body: new URLSearchParams({
				action: 'update_status_and_email',
				_wpnonce: ajaxNonce,
				data: JSON.stringify(newData)
			})
		}).then(function(response) {
			return response.json();
			// Parse response as JSON
		}).then(function(data) {
			if (data && data.success) {
				getActiveTabAndReload();
			} else {
				hideLoading();
				alert('Error while saving your table: ' + data.data);
			}
		}).catch(function(error) {
			hideLoading();
			alert('Error:', error);
		});
	}
}	
	
function populatePage(data){	
	if (!first_name || !last_name || !email || !postal_code || !phone_number || !fileList ){return;}
	
	if (title){
		title.textContent = (data.first_name || '') + ' '+ (data.last_name || '');
		}

	first_name.value = data.first_name || '';
	last_name.value = data.last_name || '';
	email.value = data.email || '';
	postal_code.value = data.postal_code || '';
	phone_number.value = data.phone_number || '';
	language.value = data.language || '';
	address.value = data.address || '';
	
	//Right now we assume first forecast
	if (data.forecasts.length > 0){
		teamSelected.value = data.forecasts[0].team_assigned ? data.forecasts[0].team_assigned : '';
		if (teamSelected.value){notifyTeamBtn.disabled = false;}
		
		orderStatus.value = data.forecasts[0].order_status ? data.forecasts[0].order_status : '';
		if (orderStatus.value){notifyCustomerBtn.disabled = false;} else {notifyCustomerBtn.disabled = true;}
		orderNotification = data.forecasts[0].order_status_notification ? data.forecasts[0].order_status_notification : '';

		if (data.forecasts[0].image_url){
				loadDocs(data.forecasts[0].image_url, imageList, allImages);
		}	else{
			if (imageList) {
        imageList.textContent = 'No images selected';
				imageList.style.setProperty('padding-top', '7px', 'important');
    	}
		}
		
		if (data.forecasts[0].doc_url){
				loadDocs(data.forecasts[0].doc_url, fileList, allDocs);
		}	else{
			if (fileList) {
        fileList.textContent = 'No file selected';
				fileList.style.setProperty('padding-top', '7px', 'important');
    	}
		}
		
		renderForecastTable(data);
	}else{
		forecastTableContainer.innerHTML = 'No data found';
		teamSelected.disabled = true;
		orderStatus.disabled = true;
		notifyCustomerBtn.disabled = true;
	}
	
	hideLoading();	
}

// Load existing URLs into a file list container
function loadDocs(docs, container, allFiles) {
    if (!Array.isArray(docs)) docs = [];

    container.textContent = '';
    container.style.setProperty('padding-top', '7px', 'important');

    if (docs.length === 0) {
        container.textContent = 'No file selected';
        return;
    }

		docs.forEach(url => {
			addFileItem(url, container, true);
			allFiles.push({ url }); // Track URL
	});
}
	
