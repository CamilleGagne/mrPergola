<script>
var noteType, noteContent, saveNoteBtn;	
jQuery(document).ready(function () {
    jQuery(document).on('elementor/popup/show', function (event, popup) {
        if (popup !== 4837) {return;}
        noteType = document.getElementById('note_type');
        noteContent = document.getElementById('note_content');
        saveNoteBtn = document.getElementById('customer_note_save_btn');
        if (!noteType || !noteContent || !saveNoteBtn){return;}
        
        noteType.addEventListener('change', function(){
            if(noteContent.value){
                saveNoteBtn.disabled = false;
            }
        });
        
        noteContent.addEventListener('change', function(){
            if(noteType.value){
                saveNoteBtn.disabled = false;
            }
        });

        if (saveNoteBtn) {
            saveNoteBtn.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                saveCustomerNote(noteType, noteContent);
            });
        }	
    });

    function getIdFromUrl(){
        var query = window.location.search.substring(1); 
        var vars = query.split('&');
        for (var i = 0; i < vars.length; i++) {
            var pair = vars[i].split('=');
            if (pair[0] === 'id') {
                return decodeURIComponent(pair[1]);
            }
        }
        return null;
    }

    function saveCustomerNote(noteType, noteContent) {
        var ajaxDataDiv = document.getElementById('ajax-data-block-client-note');
        var ajaxNonce = ajaxDataDiv.getAttribute('data-nonce');
        var id = getIdFromUrl();
        if (!id){
            saveNoteBtn.disabled = true;
            return;
        }
        var noteData = {
            'noteType': noteType.value,
            'noteContent': noteContent.value,
            'id' : id
        };
        showLoading();
        fetch('/wp-admin/admin-ajax.php', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: new URLSearchParams({
                action: 'save_client_note',
                _wpnonce: ajaxNonce,
                data: JSON.stringify(noteData)
            })
        }).then(function(response) {
            return response.json();
        }).then(function(data) {
            hideLoading();
            if (data && data.success) {
							location.reload();
							setTimeout(function () {
							var tabToActivate = document.querySelector('.e-n-tab-title[data-tab-index="2"]');
							if (tabToActivate) {
								tabToActivate.click(); // Triggers Elementor's tab logic
							}
						}, 500);
            }
        }).catch(function(error) {
            hideLoading();
            console.log('fetch error');
            alert('Fetch error:', error);
            console.error('Fetch error:', error);
        });
    }
});
</script>
